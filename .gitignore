# GitHub Profile Repository .gitignore
# Only README.md should be tracked in this repository

# Ignore everything by default
*

# But allow README.md
!README.md

# Allow .gitignore itself
!.gitignore

# Allow CI config (feed-driven Latest Articles workflow + Dependabot)
!.github/
!.github/dependabot.yml
!.github/workflows/
!.github/workflows/*.yml
!.github/scripts/
!.github/scripts/*.py

# macOS specific files (always ignore)
.DS_Store
.AppleDouble
.LSOverride

# IDE and editor files (always ignore)
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files (always ignore)
*.backup
*.bak
*.orig

# Log files (always ignore)
*.log

# Temporary files (always ignore)
tmp/
temp/
.tmp/
*.tmp

# Snyk Security Extension - AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md
